# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js build output
/.next/
/out/

# production artifacts
/build
/dist

# misc OS & editor files
.DS_Store
Thumbs.db
*.pem
.vscode/*
